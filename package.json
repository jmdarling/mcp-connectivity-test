{
  "name": "mcp-connectivity-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A harmless MCP hello/status tool for private network connectivity tests",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && node --test test/*.test.mjs && python3 test/tunnel-template.test.py",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "smoke": "node scripts/mcp-smoke.mjs",
    "docker:smoke": "node scripts/docker-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
